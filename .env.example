# 新用户优先在设置页填写自己的 API，无需配置所有服务商。详见 docs/API_SETUP.md。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型选择**不再由环境变量决定**：功能→模型看 config/model-routing.yaml，
# 模型/Provider 注册表看 config/models.yaml。这里只保留 Provider 的连接信息。

# TeamoRouter（Claude 中转站）：AI 对话 / 脚本 / 选题 / 拆片 / 剪辑 / 工作流 / 评论洞察 /
# 产品资料整理 / 营销图文案 / 图像模块文本。唯一例外：爆款复刻继续使用 DeepSeek。
# 只放服务端环境变量，严禁使用 NEXT_PUBLIC_ 前缀；Opus 不可用时按 Route 配置回退 DeepSeek。
TEAMOROUTER_API_KEY=

# 豆包 / 火山方舟（Ark）：生图、视觉理解、语音转写全部走这里
# 阿里云（DashScope / 百炼 / 通义千问）通道已下线，相关环境变量不再使用
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 语音转写：方舟没有独立 ASR 模型，用豆包多模态模型的音频输入（input_audio）转写
DOUBAO_ASR_MODEL=doubao-seed-2-0-lite-260428
DOUBAO_ASR_DIRECT_MAX_BYTES=10485760
DOUBAO_ASR_CHUNK_SECONDS=60
ASR_AUDIO_BITRATE=24k

TEMP_FILE_DIR=/tmp/director-platform

# 爆款复刻（原拆片）
# 视频视觉理解走火山方舟（OpenAI 兼容）；不填 REPLICA_VISION_API_KEY 时复用 ARK_API_KEY。
# 更强视觉可换成 doubao-seed-2-1-pro-260628（需先在方舟控制台开通该模型）。
DOUBAO_VISION_MODEL=doubao-seed-2-0-lite-260428
REPLICA_VISION_MODEL=
REPLICA_VISION_BASE_URL=
REPLICA_VISION_API_KEY=
REPLICA_TARGET_VIDEO_MODEL=Seedance 2.5
REPLICA_PROMPT_PROFILE=timeline-first-reference-fidelity
REPLICA_CACHE_DIR=/tmp/director-platform/replica-cache
REPLICA_SHOT_THRESHOLD=0.28
REPLICA_MAX_FRAMES=180
REPLICA_FRAME_BATCH_SIZE=10
REPLICA_MAX_PRODUCT_IMAGES=8
REPLICA_MAX_PROMPT_CHARS=60000

# 生图通道（二选一或都配）：
# - 豆包 Seedream：COMMERCE_SEEDREAM_API_KEY 或复用 ARK_API_KEY，默认模型 doubao-seedream-5-0-pro-260628
# - GPT Image 2.5：ORIGIN_GATEWAY_API_KEY + ORIGIN_GATEWAY_BASE_URL（默认 OriginGateway：https://origingateway.com）
COMMERCE_SEEDREAM_API_KEY=
ORIGIN_GATEWAY_API_KEY=
ORIGIN_GATEWAY_BASE_URL=

CRAWLER_SERVICE_URL=http://127.0.0.1:8787
CRAWLER_SERVICE_TIMEOUT_MS=45000

# 可选：抖音链接公开解析失败时，才手动启用浏览器 Cookie。
# 默认不要填写，避免 macOS 弹出 Chrome Safe Storage 钥匙串授权。
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_CHROME_PROFILE=
YTDLP_AUTO_TRY_CHROME_PROFILES=false
YTDLP_COOKIES_FILE=

# 可选：接入 Evil0ctal/Douyin_TikTok_Download_API 自部署服务后填写。
# 系统会用 GET {DOUYIN_TIKTOK_API_BASE_URL}?url=平台链接 尝试解析。
DOUYIN_TIKTOK_API_BASE_URL=

# 可选：后续接入 NanmiCoder/MediaCrawler 服务时填写本地路径或服务地址。
MEDIACRAWLER_PATH=external-tools/MediaCrawler
MEDIACRAWLER_API_BASE_URL=

# 可选：抖音高赞评论抓取高级模式。
# 仅在你确认有权访问该视频评论、并手动提供抖音 Web Cookie 时填写。
# 不配置时系统不会读取浏览器 Cookie，也不会触发 macOS 钥匙串；会自动提示手动粘贴评论兜底。
DOUYIN_COOKIE=
DOUYIN_COMMENT_COOKIE=

# 可选：给 yt-dlp / 外部解析服务使用的代理地址，当前版本仅预留配置。
LINK_ANALYZER_PROXY=

# 默认本机直接使用，无需创建账号或密码。启动命令只监听 127.0.0.1。
# 共享/公网服务必须设置为 1，关闭本机自动进入并启用账号登录；修改后重启。
DIRECTOR_REQUIRE_LOGIN=0
# 可选：指定已有管理员工作区。留空时复用第一个启用管理员；无账号时使用本机工作区。
# 不要在公开文件中填写自己的用户名。参见 docs/WEB_GUIDE.md。
DIRECTOR_LOCAL_ACCESS_USERNAME=
